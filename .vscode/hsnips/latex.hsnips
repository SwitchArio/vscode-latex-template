global
function math(context) {
  return context.scopes.some(scope => scope.startsWith("meta.math"));
}
endglobal

# =============================================================================
# STANDARD MATHEMATICAL NOTATION
# All snippets in this section expand automatically inside math environments.
# =============================================================================

context math(context)
snippet RR "Real numbers" wA
\mathbb{R}
endsnippet

context math(context)
snippet NN "Natural numbers" wA
\mathbb{N}
endsnippet

context math(context)
snippet ZZ "Integer numbers" wA
\mathbb{Z}
endsnippet

context math(context)
snippet CC "Complex numbers" wA
\mathbb{C}
endsnippet

context math(context)
snippet KK "Scalar field" wA
\mathbb{K}
endsnippet

context math(context)
snippet BB "Calligraphic B" wA
\mathcal{B}
endsnippet

context math(context)
snippet CCC "Calligraphic C" wA
\mathcal{C}
endsnippet

# =============================================================================
# MATHEMATICAL TEMPLATES
# Expansion is automatic. Tab only moves through the editable positions.
# =============================================================================

context math(context)
snippet dprod "Inner product" wA
\left\langle $1, $2 \right\rangle$0
endsnippet

context math(context)
snippet frac "Fraction" wA
\frac{$1}{$2}$0
endsnippet

context math(context)
snippet sq "Square root" wA
\sqrt{$1}$0
endsnippet

context math(context)
snippet sum "Summation" wA
\sum_{$1}^{$2} $0
endsnippet

context math(context)
snippet int "Definite integral" wA
\int_{$1}^{$2} $0
endsnippet

